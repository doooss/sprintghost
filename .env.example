# ============================================
# 👻 SprintGhost - Environment Variables
# ============================================
# cp .env.example .env && openssl rand -hex 32
# ============================================

# [Required] Encryption key (64 hex chars)
# Generate: openssl rand -hex 32
ENCRYPTION_SECRET=21af0ff4c7a00e349f6e3e01a1d428bc926c1658ff7d8e818cb5047745b2315b

# [Optional] Server
PORT=3000
NODE_ENV=development

# [Optional] Database & Redis (defaults work for local dev)
# DATABASE_PATH=./data/sprintghost.db
# REDIS_URL=redis://localhost:6379

# [Optional] Frontend API URL
# NEXT_PUBLIC_API_URL=http://localhost:3000
